---
import RootLayout from "~/layouts/RootLayout.astro";
import TeamBreadcrumbs from "./_components/TeamBreadcrumbs.astro";
import TeamCard from "./_components/TeamCard.astro";
import { teams } from "./_data/teams";
---

<RootLayout title="Teams" class="md:px-8 lg:px-16">
  <div class="px-6 lg:px-0">
    <TeamBreadcrumbs />
  </div>

  <h1
    class="text-primary-purple text-6xl font-serif font-bold px-4 pt-12 pb-10 lg:pb-16 bg-shapes"
  >
    Teams
  </h1>

  <ul
    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 px-4 lg:px-0 pb-16"
  >
    {
      teams.map((team) => (
        <li>
          <TeamCard name={team.name} slug={team.slug} image={team.image} />
        </li>
      ))
    }
  </ul>
</RootLayout>
